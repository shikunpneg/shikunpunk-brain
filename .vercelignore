# ===== Vercel 部署忽略文件 =====
# 注意：不能排除 "解决的问题/" 和 "*.pdf"，因为 desk.html 的 PDF 阅读器需要这些文件

# 排除非必要目录（这些不在 git 跟踪中，但保留以防万一）
作品图/
.claude/
.git/
.vercel/

# 排除不需要的 PDF（简历等）
resume.pdf
resume1.pdf

# 排除旧文件
resume.html
image.png

# 排除旧计划
计划.md
计划_v2.md
计划_v3.md
原始提示词.md

# 排除脚本
pdf_to_images.py

# 排除系统文件
.DS_Store
Thumbs.db

# 排除临时文件
*.tmp
*.log
*.bak
*.swp
*~

# 排除 Python 缓存
__pycache__/
*.py[cod]
